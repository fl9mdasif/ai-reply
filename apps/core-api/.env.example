# Runtime basics
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=jobabai

# Seller tokens
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# AES-256-GCM key (32 bytes, base64) for Page tokens and Google refresh tokens
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Registration
REGISTRATION_MODE=invite
INVITE_CODE=replace-with-the-invite-code-you-give-pilots

# Meta / Messenger
META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-a-non-guessable-webhook-verify-token
META_GRAPH_VERSION=v21.0

# rag-engine (internal, private network)
RAG_ENGINE_URL=http://localhost:4000
RAG_ENGINE_INTERNAL_TOKEN=replace-with-a-shared-secret
RAG_ENGINE_TIMEOUT_MS=8000

# Google OAuth / Sheets
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/seller/connect-sheets/callback

# CORS: comma separated allowlist, empty means no browser origins allowed
CORS_ORIGINS=

# Retry job (only true on the single production instance)
ENABLE_RETRY_JOB=false
