# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=jobabai

# Internal shared secret — must match core-api RAG_ENGINE_INTERNAL_TOKEN
RAG_ENGINE_INTERNAL_TOKEN=

# Server
PORT=8000
LOG_LEVEL=info

# RAG
TOP_K=4

# Set true in staging only — never in production
ENABLE_DOCS=false
